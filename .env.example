# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True

# Security (Replace with a strong random secret key in production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Configuration (SQLite default for academic setup, easily swapped to PostgreSQL/MySQL)
DATABASE_URL=sqlite:///instance/ecommerce.db

# Server Configuration
PORT=5000
HOST=127.0.0.1
